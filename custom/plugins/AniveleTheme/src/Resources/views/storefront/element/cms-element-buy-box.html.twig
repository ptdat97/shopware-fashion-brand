{% sw_extends '@Storefront/storefront/element/cms-element-buy-box.html.twig' %}

{#
    Nút mở bảng size ngay dưới bộ chọn size/màu.

    Bảng size lấy từ custom field của danh mục (SizeChartSubscriber gắn vào
    page dưới tên `aniveleSizeChart`), nên người bán sửa số đo trong
    Administration mà không cần đụng code.

    Số đo sai là nguyên nhân đổi trả hàng đầu với thời trang online, nên
    bảng size đặt ngay cạnh nút mua chứ không giấu dưới tab mô tả.
#}
{% block element_buy_box_inner %}
    {{ parent() }}

    {% set sizeChart = page.extensions.aniveleSizeChart %}

    {% if sizeChart %}
        <div class="anivele-size-chart-trigger">
            <button type="button"
                    class="btn btn-link p-0"
                    data-bs-toggle="modal"
                    data-bs-target="#anivele-size-chart-modal">
                {{ 'anivele.sizeChart.open'|trans }}
            </button>
        </div>

        <div class="modal fade anivele-size-chart-modal"
             id="anivele-size-chart-modal"
             tabindex="-1"
             aria-labelledby="anivele-size-chart-title"
             aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="anivele-size-chart-title">
                            {{ 'anivele.sizeChart.title'|trans }}{% if sizeChart.categoryName %} — {{ sizeChart.categoryName }}{% endif %}
                        </h5>
                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="{{ 'global.default.close'|trans|striptags }}"></button>
                    </div>

                    <div class="modal-body">
                        <div class="anivele-size-chart-table table-responsive">
                            {{ sizeChart.table|raw }}
                        </div>

                        {% if sizeChart.note %}
                            <p class="anivele-size-chart-note">{{ sizeChart.note }}</p>
                        {% endif %}

                        <div class="anivele-size-chart-howto">
                            <h6>{{ 'anivele.sizeChart.howToTitle'|trans }}</h6>
                            <ul>
                                <li>{{ 'anivele.sizeChart.howToBust'|trans }}</li>
                                <li>{{ 'anivele.sizeChart.howToWaist'|trans }}</li>
                                <li>{{ 'anivele.sizeChart.howToHip'|trans }}</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}
