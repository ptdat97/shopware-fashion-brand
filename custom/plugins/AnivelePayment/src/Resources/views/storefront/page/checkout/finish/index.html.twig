{% sw_extends '@Storefront/storefront/page/checkout/finish/index.html.twig' %}

{# Chèn khối QR ngay sau phần thông tin đơn, trước bảng sản phẩm —
   khách nhìn thấy mã QR đầu tiên mà không phải cuộn trang. #}
{% block page_checkout_finish_details %}
    {{ parent() }}

    {% set vietQr = page.extensions.aniveleVietQr %}

    {% if vietQr %}
        <div class="card anivele-vietqr">
            <div class="card-body">
                {% if vietQr.configured %}
                    <h3 class="anivele-vietqr-title">{{ "anivele.vietqr.title"|trans }}</h3>

                    <p class="anivele-vietqr-intro">{{ "anivele.vietqr.intro"|trans }}</p>

                    <div class="anivele-vietqr-body">
                        <div class="anivele-vietqr-code">
                            <img src="{{ vietQr.qrDataUri }}"
                                 alt="{{ "anivele.vietqr.title"|trans }}"
                                 width="280"
                                 height="280">
                        </div>

                        <dl class="anivele-vietqr-details">
                            <dt>{{ "anivele.vietqr.accountHolder"|trans }}</dt>
                            <dd>{{ vietQr.accountHolder }}</dd>

                            <dt>{{ "anivele.vietqr.accountNumber"|trans }}</dt>
                            <dd>{{ vietQr.accountNumber }}</dd>

                            <dt>{{ "anivele.vietqr.amount"|trans }}</dt>
                            <dd>{{ vietQr.amount|currency }}</dd>

                            <dt>{{ "anivele.vietqr.reference"|trans }}</dt>
                            <dd><strong>{{ vietQr.reference }}</strong></dd>
                        </dl>
                    </div>

                    <p class="anivele-vietqr-note">{{ "anivele.vietqr.note"|trans }}</p>
                {% else %}
                    {# Chưa cấu hình tài khoản ngân hàng — báo rõ thay vì hiện QR sai. #}
                    <div class="alert alert-warning" role="alert">
                        {{ "anivele.vietqr.notConfigured"|trans }}
                    </div>
                {% endif %}
            </div>
        </div>
    {% endif %}
{% endblock %}
