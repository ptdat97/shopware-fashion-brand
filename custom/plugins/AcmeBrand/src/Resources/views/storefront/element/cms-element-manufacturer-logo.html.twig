{% sw_extends '@Storefront/storefront/element/cms-element-manufacturer-logo.html.twig' %}

{#
    Logo (hoặc tên, khi chưa có logo) của nhà sản xuất ở trang chi tiết dẫn về trang
    thương hiệu trong shop, thay vì website ngoài của hãng.

    Tự vẽ thẻ <a> thay vì chỉ đổi `manufacturer.link` rồi gọi parent(), vì:
    - seoUrl() trả về placeholder (thay bằng URL thật sau khi render), nên bước kiểm
      "link đã có scheme chưa" của core thấy placeholder và tự thêm "https://" → URL hỏng
    - layout mặc định bật "mở tab mới" — vô lý với link nội bộ

    Chỉ áp dụng cho brand đang hoạt động và khi người vận hành không tự đặt link trong
    phần tử CMS; còn lại giữ nguyên hành vi của core. Phần ảnh dùng lại block của core.
#}
{% block element_manufacturer_logo_link %}
    {% set brandManufacturer = element.data.manufacturer ?? null %}
    {% set brandData = brandManufacturer ? brandManufacturer.extensions.acmeBrand ?? null : null %}

    {% if brandData and brandData.active and not config.url.value %}
        <a href="{{ seoUrl('frontend.acme.brand.page', { manufacturerId: brandManufacturer.id }) }}"
           class="cms-image-link product-detail-manufacturer-link acme-brand-manufacturer-link"
           title="{{ manufacturer.name }}">
            {% if manufacturer.media %}
                <div class="w-100 cms-image-container is-{{ config.displayMode.value }}">
                    {{ block('element_manufacturer_logo_image') }}
                </div>
            {% else %}
                {{ block('element_manufacturer_logo_text') }}
            {% endif %}
        </a>
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}
