<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="Acme\Brand\Core\Content\Brand\BrandDefinition">
            <tag name="shopware.entity.definition" entity="acme_brand"/>
        </service>

        <service id="Acme\Brand\Core\Content\Brand\Aggregate\BrandTranslation\BrandTranslationDefinition">
            <tag name="shopware.entity.definition" entity="acme_brand_translation"/>
        </service>

        <service id="Acme\Brand\Extension\ProductManufacturerBrandExtension">
            <tag name="shopware.entity.extension"/>
        </service>

        <service id="Acme\Brand\Validation\BrandCodeValidator">
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Acme\Brand\Validation\BrandUniqueExceptionHandler">
            <tag name="shopware.dal.exception_handler"/>
        </service>
    </services>
</container>
