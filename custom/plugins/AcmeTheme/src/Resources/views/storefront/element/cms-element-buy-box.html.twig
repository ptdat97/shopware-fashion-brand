{% sw_extends '@Storefront/storefront/element/cms-element-buy-box.html.twig' %}

{#
    Nút mở bảng size ngay dưới bộ chọn size/màu.

    Bảng size lấy từ custom field của DANH MỤC CHÍNH của sản phẩm —
    `page.product.seoCategory`, danh mục core đã nạp sẵn cho breadcrumb/SEO ở trang
    chi tiết (chọn được trong Administration: sản phẩm → "Danh mục chính").
    Không tự truy vấn lại danh mục (08-quy-tac-phat-trien.md, Quy tắc số 4).
    Người bán sửa số đo trong Administration mà không cần đụng code.

    Số đo sai là nguyên nhân đổi trả hàng đầu với thời trang online, nên
    bảng size đặt ngay cạnh nút mua chứ không giấu dưới tab mô tả.
#}
{% block element_buy_box_inner %}
    {{ parent() }}

    {# "Người mẫu mặc size" — custom field sản phẩm của AcmeCatalog, biến thể kế thừa từ
       cha. Không có (AcmeCatalog tắt, chưa nhập) thì không hiện gì. #}
    {% set modelSize = page.product.translated.customFields.acme_model_size ?? null %}
    {% if modelSize and modelSize|trim is not empty %}
        <p class="acme-model-size">{{ modelSize }}</p>
    {% endif %}

    {% set sizeChartCategory = page.product.seoCategory ?? null %}
    {% set sizeChartFields = sizeChartCategory ? sizeChartCategory.translated.customFields ?? {} : {} %}
    {% set sizeChart = {
        table: sizeChartFields.acme_size_chart_table ?? null,
        note: sizeChartFields.acme_size_chart_note ?? null,
        categoryName: sizeChartCategory ? sizeChartCategory.translated.name : null
    } %}

    {% if sizeChart.table and sizeChart.table|trim is not empty %}
        <div class="acme-size-chart-trigger">
            <button type="button"
                    class="btn btn-link p-0"
                    data-bs-toggle="modal"
                    data-bs-target="#acme-size-chart-modal">
                {{ 'acme-theme.sizeChart.open'|trans }}
            </button>
        </div>

        <div class="modal fade acme-size-chart-modal"
             id="acme-size-chart-modal"
             tabindex="-1"
             aria-labelledby="acme-size-chart-title"
             aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="acme-size-chart-title">
                            {{ 'acme-theme.sizeChart.title'|trans }}{% if sizeChart.categoryName %} — {{ sizeChart.categoryName }}{% endif %}
                        </h5>
                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="{{ 'global.default.close'|trans|striptags }}"></button>
                    </div>

                    <div class="modal-body">
                        <div class="acme-size-chart-table table-responsive">
                            {# HTML do người vận hành nhập ở Administration → lọc thẻ (SEC-03) #}
                            {{ sizeChart.table|sw_sanitize }}
                        </div>

                        {% if sizeChart.note %}
                            <p class="acme-size-chart-note">{{ sizeChart.note }}</p>
                        {% endif %}

                        <div class="acme-size-chart-howto">
                            <h6>{{ 'acme-theme.sizeChart.howToTitle'|trans }}</h6>
                            <ul>
                                <li>{{ 'acme-theme.sizeChart.howToBust'|trans }}</li>
                                <li>{{ 'acme-theme.sizeChart.howToWaist'|trans }}</li>
                                <li>{{ 'acme-theme.sizeChart.howToHip'|trans }}</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}
