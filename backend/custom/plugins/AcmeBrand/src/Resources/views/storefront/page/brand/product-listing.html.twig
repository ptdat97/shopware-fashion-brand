{#
    Bộ lọc + danh sách sản phẩm của brand, dùng lại nguyên component listing của core.

    - dataUrl: route AJAX của plugin — listing JS gọi khi lọc / sắp xếp / sang trang
    - filterUrl: null, nên phải tắt disableEmptyFilter (shop đang bật
      core.listing.disableEmptyFilterOptions): bật mà không có filterUrl thì JS gọi
      fetch(null)
#}
{% block acme_brand_product_listing %}
    {% set dataUrl = path('frontend.acme.brand.listing', { manufacturerId: manufacturerId }) %}

    {% block acme_brand_product_listing_filter %}
        {% if searchResult.aggregations.elements|length > 0 %}
            <div class="cms-element-sidebar-filter acme-brand-filter">
                <button
                    class="btn btn-outline-primary filter-panel-wrapper-toggle"
                    type="button"
                    data-off-canvas-filter="true"
                    aria-haspopup="dialog"
                >
                    {% sw_icon 'sliders-horizontal' style { size: 'sm' } %}
                    {{ 'listing.filterTitleText'|trans }}
                </button>

                <div id="filter-panel-wrapper" class="filter-panel-wrapper" data-off-canvas-filter-content="true">
                    {% sw_include '@Storefront/storefront/component/listing/filter-panel.html.twig' with {
                        listing: searchResult,
                        sidebar: false,
                        ariaLiveUpdates: true
                    } %}
                </div>
            </div>
        {% endif %}
    {% endblock %}

    {% block acme_brand_product_listing_items %}
        {% sw_include '@Storefront/storefront/component/product/listing.html.twig' with {
            searchResult: searchResult,
            dataUrl: dataUrl,
            filterUrl: null,
            disableEmptyFilter: false,
            params: { 'no-aggregations': 1 },
            sidebar: false,
            boxLayout: 'standard',
            displayMode: 'standard',
            listingColumns: 'col-sm-6 col-lg-4 col-xl-3',
            ariaLiveUpdates: true
        } %}
    {% endblock %}
{% endblock %}
