{% sw_extends '@Storefront/storefront/base.html.twig' %}

{# @var page \Acme\Brand\Storefront\Page\Brand\BrandPage #}
{% block base_head %}
    {% sw_include '@AcmeBrand/storefront/page/brand/meta.html.twig' %}
{% endblock %}

{% block base_main_inner %}
    {% set manufacturer = page.manufacturer %}
    {% set brand = page.brand %}

    <div class="container-main acme-brand-page">
        {% block acme_brand_page_breadcrumb %}
            <nav class="acme-brand-breadcrumb container" aria-label="{{ 'acme-brand.page.breadcrumb'|trans|striptags }}">
                <a href="{{ path('frontend.acme.brand.list') }}">{{ 'acme-brand.list.title'|trans }}</a>
                <span aria-hidden="true">/</span>
                <span aria-current="page">{{ manufacturer.translated.name }}</span>
            </nav>
        {% endblock %}

        {% block acme_brand_page_banner %}
            {% if brand.bannerMedia %}
                <div class="acme-brand-banner">
                    {% sw_thumbnails 'acme-brand-banner-thumbnails' with {
                        media: brand.bannerMedia,
                        sizes: { default: '100vw' },
                        attributes: { class: 'acme-brand-banner-image', alt: manufacturer.translated.name, loading: 'eager' }
                    } %}
                </div>
            {% endif %}
        {% endblock %}

        {% block acme_brand_page_header %}
            <header class="acme-brand-header container">
                {% if manufacturer.media %}
                    <img class="acme-brand-logo"
                         src="{{ manufacturer.media.url }}"
                         alt="{{ manufacturer.translated.name }}">
                {% endif %}

                <h1 class="acme-brand-name">{{ manufacturer.translated.name }}</h1>

                {% if manufacturer.translated.description %}
                    <div class="acme-brand-description">
                        {{ manufacturer.translated.description|sw_sanitize }}
                    </div>
                {% endif %}
            </header>
        {% endblock %}

        {% block acme_brand_page_cms %}
            {% if page.cmsPage %}
                <div class="acme-brand-cms">
                    {% sw_include '@Storefront/storefront/page/content/detail.html.twig' with { cmsPage: page.cmsPage } %}
                </div>
            {% endif %}
        {% endblock %}

        {% block acme_brand_page_products %}
            <section class="acme-brand-products container" aria-labelledby="acme-brand-products-title">
                <h2 id="acme-brand-products-title" class="acme-brand-products-title">
                    {{ 'acme-brand.page.productsTitle'|trans({ '%brand%': manufacturer.translated.name }) }}
                </h2>

                {% sw_include '@AcmeBrand/storefront/page/brand/product-listing.html.twig' with {
                    searchResult: page.listing,
                    manufacturerId: manufacturer.id
                } %}
            </section>
        {% endblock %}
    </div>
{% endblock %}
