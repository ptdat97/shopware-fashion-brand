<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="Acme\Brand\Core\Content\Brand\BrandDefinition">
            <tag name="shopware.entity.definition" entity="acme_brand"/>
        </service>

        <service id="Acme\Brand\Extension\ProductManufacturerBrandExtension">
            <tag name="shopware.entity.extension"/>
        </service>

        <service id="Acme\Brand\Validation\BrandCodeValidator">
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Acme\Brand\Validation\BrandUniqueExceptionHandler">
            <tag name="shopware.dal.exception_handler"/>
        </service>

        <!-- MB3: storefront thương hiệu -->
        <service id="Acme\Brand\Seo\BrandPageSeoUrlRoute">
            <argument type="service" id="Shopware\Core\Content\Product\Aggregate\ProductManufacturer\ProductManufacturerDefinition"/>
            <tag name="shopware.seo_url.route"/>
        </service>

        <!-- SEO URL qua cơ chế indexing của core (như LandingPageIndexer) — dal:refresh:index phủ luôn -->
        <service id="Acme\Brand\Core\Content\Brand\DataAbstractionLayer\BrandIndexer">
            <argument type="service" id="Shopware\Core\Framework\DataAbstractionLayer\Dbal\Common\IteratorFactory"/>
            <argument type="service" id="Acme\Brand\Core\Content\Brand\BrandDefinition"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="Shopware\Core\Content\Seo\SeoUrlUpdater"/>
            <tag name="shopware.entity_indexer"/>
        </service>

        <service id="Acme\Brand\Sitemap\BrandUrlProvider">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <tag name="shopware.sitemap_url_provider"/>
        </service>

        <!-- H2: Store API thương hiệu — frontend headless và trang Twig dùng chung -->
        <service id="Acme\Brand\Core\Content\Brand\SalesChannel\ActiveBrandLoader">
            <argument type="service" id="product_manufacturer.repository"/>
        </service>

        <service id="Acme\Brand\Core\Content\Brand\SalesChannel\BrandListRoute" public="true">
            <argument type="service" id="product_manufacturer.repository"/>
        </service>

        <service id="Acme\Brand\Core\Content\Brand\SalesChannel\BrandRoute" public="true">
            <argument type="service" id="Acme\Brand\Core\Content\Brand\SalesChannel\ActiveBrandLoader"/>
            <argument type="service" id="Shopware\Core\Content\Cms\SalesChannel\SalesChannelCmsPageLoader"/>
        </service>

        <service id="Acme\Brand\Core\Content\Brand\SalesChannel\BrandListingRoute" public="true">
            <argument type="service" id="Acme\Brand\Core\Content\Brand\SalesChannel\ActiveBrandLoader"/>
            <argument type="service" id="Shopware\Core\Content\Product\SalesChannel\Listing\ProductListingRoute"/>
        </service>

        <service id="Acme\Brand\Seo\BrandStoreApiUrlRoute">
            <argument type="service" id="Shopware\Core\Content\Product\Aggregate\ProductManufacturer\ProductManufacturerDefinition"/>
            <tag name="shopware.entity.seo_url.route"/>
        </service>

        <service id="Acme\Brand\Storefront\Page\Brand\BrandPageLoader">
            <argument type="service" id="Shopware\Storefront\Page\GenericPageLoader"/>
            <argument type="service" id="Acme\Brand\Core\Content\Brand\SalesChannel\BrandListRoute"/>
            <argument type="service" id="Acme\Brand\Core\Content\Brand\SalesChannel\BrandRoute"/>
            <argument type="service" id="Acme\Brand\Core\Content\Brand\SalesChannel\BrandListingRoute"/>
            <argument type="service" id="Acme\Brand\Core\Content\Brand\SalesChannel\ActiveBrandLoader"/>
            <argument type="service" id="event_dispatcher"/>
            <argument type="service" id="translator"/>
        </service>

        <service id="Acme\Brand\Storefront\Controller\BrandController" public="true">
            <argument type="service" id="Acme\Brand\Storefront\Page\Brand\BrandPageLoader"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>
    </services>
</container>
