<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="Acme\Payment\Service\VietQrPayloadBuilder"/>

        <service id="Acme\Payment\Service\VietQrRenderer">
            <argument type="service" id="Acme\Payment\Service\VietQrPayloadBuilder"/>
        </service>

        <service id="Acme\Payment\Service\BankTransferInfoProvider">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="Acme\Payment\Service\VietQrRenderer"/>
        </service>

        <service id="Acme\Payment\Core\Checkout\Payment\SalesChannel\BankTransferRoute" public="true">
            <argument type="service" id="Shopware\Core\Checkout\Order\SalesChannel\OrderRoute"/>
            <argument type="service" id="Acme\Payment\Service\BankTransferInfoProvider"/>
        </service>

    </services>
</container>
