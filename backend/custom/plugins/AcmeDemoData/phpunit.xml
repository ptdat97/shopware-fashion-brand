<?xml version="1.0" encoding="UTF-8"?>
<!--
    Chạy từ thư mục backend/ của monorepo:
        vendor/bin/phpunit -c custom/plugins/AcmeDemoData

    Chỉ có unit test cho dữ liệu khai báo — không cần kernel, không cần DB.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../../../vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory="../../../var/cache/phpunit-acme-demo-data"
         colors="true">
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
