{
  "name": "frontend",
  "version": "0.0.0",
  "description": "Storefront headless (Nuxt 4) cho nền tảng thời trang đa thương hiệu",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt prepare && nuxt dev",
    "build": "nuxt prepare && nuxt build",
    "nuxt-prepare": "nuxt prepare",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint --fix . && oxfmt --write . && pnpm run typecheck",
    "typecheck": "nuxt prepare && nuxi typecheck",
    "generate-types": "shopware-api-gen generate --apiType=store"
  },
  "dependencies": {
    "@iconify-json/carbon": "1.2.27",
    "@iconify/utils": "3.1.7",
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/icon": "2.5.1",
    "@nuxt/image": "2.1.0",
    "@nuxt/vite-builder": "4.6.1",
    "@nuxtjs/i18n": "10.4.0",
    "@regle/core": "1.25.2",
    "@regle/rules": "1.25.2",
    "@shopware/api-client": "canary",
    "@shopware/cms-base-layer": "canary",
    "@shopware/composables": "canary",
    "@shopware/helpers": "canary",
    "@shopware/nuxt-module": "canary",
    "@shopware/unocss-design-tokens-layer": "canary",
    "@unocss/core": "66.10.5",
    "@unocss/nuxt": "66.10.5",
    "@vueuse/core": "15.0.0",
    "@vueuse/nuxt": "15.0.0",
    "nuxt": "4.6.1",
    "scule": "1.3.0",
    "unocss": "66.10.5",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@nuxt/kit": "4.6.1",
    "@shopware/api-gen": "canary",
    "@types/js-cookie": "^3.0.6",
    "@types/three": "^0.186.0",
    "@vue/compiler-sfc": "3.5.43",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vue-tsc": "3.3.11"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
